/include/ "system-conf.dtsi"
/ {
};

&axi_iic_0 {
    clock-frequency = <100000>;
    status = "okay";
};

&spi0 {
    status = "okay";
    num-cs = <2>;

    spidev0: spidev@0 {
        compatible = "spidev";
        reg = <0>;                      /* CS0 */
        spi-max-frequency = <10000000>; /* MCP4911 allows up to 20 MHz */
    };

    spidev1: spidev@1 {
        compatible = "spidev";
        reg = <1>;                      /* CS1 */
        spi-max-frequency = <10000000>; /* MCP4911 allows up to 20 MHz */
    };
};
