/include/ "system-conf.dtsi"
/ {
};

&spi0 {
    status = "okay";
    num-cs = <3>;

    spidev0: spidev@0 {
        compatible = "spidev";
        reg = <0>;
        spi-max-frequency = <1000000>;
    };
    
    spidev1: spidev@1 {
        compatible = "spidev";
        reg = <1>;
        spi-max-frequency = <1000000>;
    };
};




